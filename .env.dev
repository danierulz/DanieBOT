# Desarrollo local con Docker Compose (Postgres en contenedor `db`).
# NO apunta a Cloud SQL. Copiá valores de Meta/ngrok desde tu .env de prod si los necesitás.

# --- Postgres (imagen oficial usa POSTGRES_*; la app usa DB_*) ---
POSTGRES_USER=daniebot
POSTGRES_PASSWORD=daniebot_dev
POSTGRES_DB=daniebot_dev

DB_USER=daniebot
DB_PASSWORD=daniebot_dev
DB_HOST=db
DB_PORT=5432
DB_NAME=daniebot_dev

# SQL en consola (opcional)
# DB_ECHO=true

# --- WhatsApp / Meta (rellenar para probar webhook con perfil whatsapp) ---
PYWA_VERIFY_TOKEN=dev-verify-token
PYWA_AUTH_TOKEN=
PYWA_PHONE_ID=
APP_ID=
APP_SECRET=

# ngrok: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# --- Almacenamiento de imágenes (sin GCP en local) ---
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=static/uploads

# --- GCP (solo producción / STORAGE_BACKEND=gcs) ---
GOOGLE_CLOUD_PROJECT=local-dev
# GCS_BUCKET_NAME=bucket_laslocas_prod

# --- Import mayorista Las Locas (opcional) ---
LOGIN_EMAIL=
LOGIN_PASS=

# --- Sitio (defaults razonables en local) ---
SITE_PUBLIC_URL=http://localhost:5000
ORDER_CODE_PREFIX=OJ
