# Desarrollo con Neon (sin contenedor Postgres local).
# Copiá a .env.neon y pegá la URL desde https://console.neon.tech/
# Usá el host *-pooler* (recomendado para la app).

DATABASE_URL=postgresql+psycopg2://USER:PASS@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Opcional: preview del logo en /dev/brand-logo
APP_DEBUG=true

# --- WhatsApp / Meta (rellenar si probás webhook) ---
PYWA_VERIFY_TOKEN=dev-verify-token
PYWA_AUTH_TOKEN=
PYWA_PHONE_ID=
APP_ID=
APP_SECRET=

NGROK_AUTHTOKEN=

STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=static/uploads
GOOGLE_CLOUD_PROJECT=local-dev

SITE_PUBLIC_URL=http://localhost:8080
ORDER_CODE_PREFIX=OJ

# No uses DB_HOST=db aquí — DATABASE_URL tiene prioridad sobre DB_*.
