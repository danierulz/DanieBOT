# Plantilla de variables. Copiar según entorno:
#   Desarrollo Docker:  cp .env.example .env.dev  (o usar .env.dev del repo)
#   Producción / Cloud: cp .env.example .env      (nunca commitear .env)

# --- Base de datos ---
# En Docker Compose local: DB_HOST=db (ver .env.dev)
# En Cloud Run / VPC:       DB_HOST=<ip o socket Cloud SQL>
# Alembic/tests en el host contra compose: DB_HOST=localhost, mismo puerto 5432
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# DATABASE_URL=postgresql+pg8000://user:pass@host:5432/dbname
# SKIP_DB_MIGRATIONS=1

# --- WhatsApp / Meta ---
# PYWA_PHONE_ID = Phone number ID (solo dígitos) en Meta Developer → WhatsApp → API Setup
# NO usar el número de teléfono visible (+54 11 …). Sin signo +.
PYWA_VERIFY_TOKEN=
PYWA_AUTH_TOKEN=
PYWA_PHONE_ID=
APP_ID=
APP_SECRET=

# --- ngrok (solo desarrollo) ---
NGROK_AUTHTOKEN=

# --- Almacenamiento de imágenes ---
# local = disco (desarrollo); gcs = Google Cloud Storage (producción)
STORAGE_BACKEND=gcs
LOCAL_UPLOAD_DIR=static/uploads
GCS_BUCKET_NAME=bucket_laslocas_prod

# --- GCP ---
GOOGLE_CLOUD_PROJECT=

# --- Import Las Locas ---
LOGIN_EMAIL=
LOGIN_PASS=

# --- Sitio ---
SITE_PUBLIC_URL=https://tu-dominio.com
SITE_WA_BOT=
SITE_WA_ASESOR=
ORDER_CODE_PREFIX=OJ
