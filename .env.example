# Plantilla de variables. Copiar según entorno:
#   Desarrollo Docker (Postgres local): cp .env.example .env.dev
#   Desarrollo Docker + Neon:           cp .env.neon.example .env.neon
#   Desarrollo sin Docker + Neon:       cp .env.neon.example .env  (solo DATABASE_URL)
#   Producción / Cloud:                 cp .env.example .env  (nunca commitear)

# --- Base de datos ---
# En Docker Compose local: DB_HOST=db (ver .env.dev)
# En Cloud Run: CLOUD_SQL_CONNECTION_NAME=proyecto:region:instancia (ver cloudbuild.yaml)
# Alternativa: DB_HOST=laslocaswhatsapp:us-central1:laslocas-dbng
# Desarrollo local con proxy: DB_HOST=127.0.0.1
# Alembic/tests en el host contra compose: DB_HOST=localhost, mismo puerto 5432
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# Migración Cloud SQL → Neon (scripts/migrate_cloudsql_to_neon.sh):
# TARGET_DATABASE_URL=  # Neon pooler (o usar DATABASE_URL)
# SOURCE_DATABASE_URL=  # opcional; si falta, usa DB_* o proxy + DB_*
# CLOUD_SQL_CONNECTION_NAME=proyecto:region:instancia
# SKIP_DB_MIGRATIONS=1

# --- WhatsApp / Meta ---
# PYWA_PHONE_ID = Phone number ID (solo dígitos) en Meta Developer → WhatsApp → API Setup
# NO usar el número de teléfono visible (+54 11 …). Sin signo +.
PYWA_VERIFY_TOKEN=
PYWA_AUTH_TOKEN=
PYWA_PHONE_ID=
APP_ID=
APP_SECRET=

# --- ngrok (solo desarrollo) ---
NGROK_AUTHTOKEN=

# --- Almacenamiento de imágenes ---
# local = disco (desarrollo); gcs = Google Cloud Storage (producción)
STORAGE_BACKEND=gcs
LOCAL_UPLOAD_DIR=static/uploads
GCS_BUCKET_NAME=bucket_laslocas_prod

# --- GCP ---
GOOGLE_CLOUD_PROJECT=

# --- Import Las Locas ---
LOGIN_EMAIL=
LOGIN_PASS=

# --- Admin panel (login JWT) ---
# Generar con: python scripts/setup_admin_auth.py
# En producción: guardar en Secret Manager y montar en Cloud Run (ver docs/specs/22-admin-auth-config.md)
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
# Solo desarrollo temporal (no usar en prod):
# ADMIN_PASSWORD=

# --- Nav público (login admin) ---
# false = sin botón Login en la tienda; ingresá directo a /login (bookmark)
ADMIN_LOGIN_NAV_VISIBLE=false
# ADMIN_LOGIN_PATH=/login

# --- Sitio ---
SITE_PUBLIC_URL=https://tu-dominio.com
SITE_WA_BOT=
SITE_WA_ASESOR=
ORDER_CODE_PREFIX=OJ

# --- Avisos de pedidos al admin (email SMTP) — OPCIONAL ---
# Complemento al aviso WhatsApp (SITE_WA_ASESOR). Si falta config, el pedido se registra igual.
# Guía dominio propio (NIC + Zoho): docs/specs/20-email-dominio-propio.md
# Verificar: python scripts/verify_smtp.py [--send-test]
# Activar en producción: setup_smtp_secrets.ps1 + cloudbuild.yaml (ver docs/specs/20-email-dominio-propio.md)
ADMIN_NOTIFY_EMAIL_ENABLED=false
# Ejemplo Zoho (descomentar y completar cuando tengas buzón + app password):
# ADMIN_NOTIFY_EMAIL=pedidos@outfitjazmines.com.ar
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USER=pedidos@outfitjazmines.com.ar
# SMTP_PASSWORD=
# SMTP_FROM=pedidos@outfitjazmines.com.ar
